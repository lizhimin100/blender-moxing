"""unit_魔金傀儡.py —— 秘法·魔金傀儡（Arcane Gold Golem，精模：低模 cage + 曲面细分）

设计口径（与破法者同一套库、同一套笔触）：
  * 1 unit = 1 m，+Y 正面，脚底 z = 0，原点在双足中间；总高 4.35 m（= 2.5 个联盟步兵）。
  * "一个穿铠甲的大号人"：宽肩 1.30 / 窄腰 0.86 / 粗腿 / 两只巨大握紧的拳头，没有武器。
  * 体积件走 8/12 点椭圆截面 + Catmull-Clark（soft / soft2）；
    甲片走 arc 弧形壳 + 倒角（plate）。**任何零件都不出现 4 点方截面。**
  * 一块 = 一根骨、权重 1.0；关节留 2~4 cm 缝，缝里是 铁 色内胆（不做平滑权重）。

三条读感（俯角 96 px 仍要指认）：
  ① 头小（0.56 宽）+ 光滑圆顶盔 + 一条水平发光眼缝 —— 不戴冠、不长角；
  ② 肩极宽（护肩外沿 ±0.96）+ 胸甲 1.30 的桶形 —— 剪影是倒梯形；
  ③ 两只 0.60×0.56×0.62 的大拳头垂在胯侧 —— 这是全身最重的两块体积。

配色秩序（只靠明度分三档，不换色相）：
  铁 #2B3039（缝/内胆） < 金暗 #8A6C38（次级甲/过渡） < 金 #C9A24E（主甲）
  + team 蓝只落在胸口核心环、腰侧窄带；辉 青只落在眼缝/核心/纹路。

组件化（MODULES）：四层，各自成物体
  body      腿/胯/腹/胸/臂/拳
  head      盔 + 面甲 + 眼缝 + 盔脊
  pauldron  护肩两层 ×2
  runes     胸口核心 + 胸/肩/前臂/腿的发光线（独立小件，供动画缩放脉冲）
"""
import math
import os
import sys

import bpy
from mathutils import Vector

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = HERE
while not os.path.isdir(os.path.join(ROOT, "库")):
    _up = os.path.dirname(ROOT)
    if _up == ROOT:
        break
    ROOT = _up
LIB = os.path.join(ROOT, "库")
for _p in (LIB, HERE):
    if _p not in sys.path:
        sys.path.insert(0, _p)

import unitkit2 as K  # noqa: E402
import unitkit as KU  # noqa: E402  （只借 _obj 建自定义网格）

NAME = "魔金傀儡"
PREFIX = "mg"

# ── 尺寸表（m）──────────────────────────────────────────────────────────────
Z_ANKLE = 0.30
Z_KNEE = 1.16
Z_HIP = 2.05
Z_WAIST = 2.30
Z_CHEST = 2.85
Z_SHLD = 3.42
Z_NECK = 3.60
Z_TOP = 4.34

HIP_X = 0.295          # 胯关节（比脚窄，腿微微外八）
LEG_X = 0.365          # 踝 / 脚中心
SH_X = 0.60           # 肩关节

L_THIGH, L_SHIN = 0.92, 0.88
L_UPPER, L_FORE = 0.70, 0.66

SH_R = Vector((SH_X, 0.0, Z_SHLD))
SH_L = Vector((-SH_X, 0.0, Z_SHLD))

FIST_R = Vector((0.955, 0.360, 1.940))          # 拳心
FIST_L = Vector((-0.955, 0.360, 1.940))
FIST_W, FIST_D, FIST_H = 0.72, 0.66, 0.66     # 宽 / 厚 / 高
WRIST_OFF = 0.285

HIP_R = Vector((HIP_X, 0.0, Z_HIP))
HIP_L = Vector((-HIP_X, 0.0, Z_HIP))
ANK_R = Vector((LEG_X, 0.015, Z_ANKLE))
ANK_L = Vector((-LEG_X, 0.015, Z_ANKLE))
BALL_R = Vector((LEG_X, 0.150, 0.105))
BALL_L = Vector((-LEG_X, 0.150, 0.105))
TOE_R = Vector((LEG_X, 0.275, 0.070))
TOE_L = Vector((-LEG_X, 0.275, 0.070))


def ik2(root, target, l1, l2, pole):
    root, target = Vector(root), Vector(target)
    d = target - root
    dist = min(d.length, (l1 + l2) * 0.999)
    dn = d.normalized()
    a = (l1 * l1 - l2 * l2 + dist * dist) / (2 * dist)
    h = math.sqrt(max(l1 * l1 - a * a, 0.0))
    p = Vector(pole) - dn * Vector(pole).dot(dn)
    if p.length < 1e-6:
        p = Vector((0, 0, 1)) - dn * dn.z
    p.normalize()
    return root + dn * a + p * h


def wrist_of(fist, shoulder, off=WRIST_OFF):
    return Vector(fist) - (Vector(fist) - Vector(shoulder)).normalized() * off


WRI_R = wrist_of(FIST_R, SH_R)
WRI_L = wrist_of(FIST_L, SH_L)
ELB_R = ik2(SH_R, WRI_R, L_UPPER, L_FORE, (0.55, -1.00, 0.0))
ELB_L = ik2(SH_L, WRI_L, L_UPPER, L_FORE, (-0.55, -1.00, 0.0))
KNE_R = ik2(HIP_R, ANK_R, L_THIGH, L_SHIN, (0.0, 1.0, 0.0))
KNE_L = ik2(HIP_L, ANK_L, L_THIGH, L_SHIN, (0.0, 1.0, 0.0))

HDIR_R = (FIST_R - WRI_R).normalized()
HDIR_L = (FIST_L - WRI_L).normalized()

# 胸口核心（贴胸甲正面）
CORE_C = Vector((0.0, 0.335, 2.965))
PAUL_C = Vector((0.605, -0.004, 3.395))       # 护肩球心

# ── 骨架（26 根：6 躯干 + 8 臂 + 8 腿 + 4 纹路）─────────────────────────────
def _bones():
    b = [
        ("root",  (0, 0, 0), (0, 0, 0.34), None),
        ("hips",  (0, 0, Z_HIP), (0, 0, Z_WAIST), "root"),
        ("spine", (0, 0, Z_WAIST), (0, 0, 2.72), "hips"),
        ("chest", (0, 0, 2.72), (0, 0, Z_SHLD), "spine"),
        ("neck",  (0, 0, Z_SHLD), (0, 0, 3.66), "chest"),
        ("head",  (0, 0, 3.66), (0, 0, 4.28), "neck"),
    ]
    for s, side in ((1, "R"), (-1, "L")):
        sh = SH_R if s > 0 else SH_L
        el = ELB_R if s > 0 else ELB_L
        wr = WRI_R if s > 0 else WRI_L
        hd = HDIR_R if s > 0 else HDIR_L
        b += [
            ("shoulder_" + side, (s * 0.10, 0, 3.36), tuple(sh), "chest"),
            ("upperarm_" + side, tuple(sh), tuple(el), "shoulder_" + side),
            ("forearm_" + side, tuple(el), tuple(wr), "upperarm_" + side),
            ("hand_" + side, tuple(wr), tuple(wr + hd * 0.24), "forearm_" + side),
        ]
        hip = HIP_R if s > 0 else HIP_L
        kne = KNE_R if s > 0 else KNE_L
        ank = ANK_R if s > 0 else ANK_L
        ball = BALL_R if s > 0 else BALL_L
        toe = TOE_R if s > 0 else TOE_L
        b += [
            ("thigh_" + side, tuple(hip), tuple(kne), "hips"),
            ("shin_" + side, tuple(kne), tuple(ank), "thigh_" + side),
            ("foot_" + side, tuple(ank), tuple(ball), "shin_" + side),
            ("toe_" + side, tuple(ball), tuple(toe), "foot_" + side),
        ]
    b += [
        ("rune_chest", (0, 0.335, 3.02), (0, 0.360, 3.22), "chest"),
        ("rune_R", (0.86, 0.00, 3.46), (0.94, 0.16, 3.46), "shoulder_R"),
        ("rune_L", (-0.86, 0.00, 3.46), (-0.94, 0.16, 3.46), "shoulder_L"),
        ("core", tuple(CORE_C), (CORE_C.x, CORE_C.y + 0.10, CORE_C.z), "chest"),
    ]
    return b


BONES = _bones()
BONE_NAMES = [b[0] for b in BONES]

MODULES = ("body", "head", "pauldron", "runes")

MATS = {
    "金":        dict(hexcol="#C9A24E", metal=0.95, rough=0.16),
    "金暗":      dict(hexcol="#8A6C38", metal=0.90, rough=0.30),
    "铁":        dict(hexcol="#2B3039", metal=0.55, rough=0.48),
    "team":      dict(hexcol="#2B57A6", metal=0.30, rough=0.45),
    "team_trim": dict(hexcol="#E0C070", metal=0.85, rough=0.22),
    "辉":        dict(hexcol="#4FD8FF", metal=0.0, rough=0.20,
                      emit="#4FD8FF", estr=3.0),
}


# ══ 通用小件 ════════════════════════════════════════════════════════════════
def dome_patch(name, center, rx, ry, rz, a0, a1, p0, p1, nu, nv, thick, tilt=0.0):
    """球面片：theta 从 +X 起绕 Z，phi 从 +Z 往下（度）；tilt 绕 Y 轴外倾。"""
    ca, sa = math.cos(math.radians(tilt)), math.sin(math.radians(tilt))
    grid = []
    for j in range(nv + 1):
        phi = math.radians(p0 + (p1 - p0) * j / nv)
        row = []
        for i in range(nu + 1):
            th = math.radians(a0 + (a1 - a0) * i / nu)
            lx = rx * math.sin(phi) * math.cos(th)
            ly = ry * math.sin(phi) * math.sin(th)
            lz = rz * math.cos(phi)
            row.append((center[0] + lx * ca + lz * sa,
                        center[1] + ly,
                        center[2] - lx * sa + lz * ca))
        grid.append(row)
    return K.grid_shell(name, grid, thick, inside=center)


def limb_band(name, p0, p1, r0, r1, a0, a1, nv, nu, thick, out_dir):
    """绕骨轴的弧形甲片。角度 0 = out_dir 方向。"""
    p0, p1 = Vector(p0), Vector(p1)
    ez = (p1 - p0).normalized()
    out = Vector(out_dir)
    out = (out - ez * out.dot(ez)).normalized()
    perp = ez.cross(out).normalized()
    L = (p1 - p0).length
    grid = []
    for j in range(nv + 1):
        t = j / nv
        r = r0 + (r1 - r0) * t
        c = p0 + ez * (L * t)
        row = []
        for i in range(nu + 1):
            a = math.radians(a0 + (a1 - a0) * i / nu)
            row.append(tuple(c + out * (r * math.cos(a)) + perp * (r * math.sin(a))))
        grid.append(row)
    return K.grid_shell(name, grid, thick, inside=tuple((p0 + p1) * 0.5))


def disc(name, center, normal, r, thick, n=20):
    c = Vector(center)
    ez = Vector(normal).normalized()
    up = Vector((0, 0, 1))
    if abs(ez.dot(up)) > 0.95:
        up = Vector((0, 1, 0))
    ex = up.cross(ez).normalized()
    ey = ez.cross(ex).normalized()
    rows = []
    for (o, rr) in ((-thick * 0.5, r * 0.84), (-thick * 0.5 + 0.008, r),
                    (thick * 0.5 - 0.008, r), (thick * 0.5, r * 0.84)):
        rows.append([tuple(c + ez * o + ex * (rr * math.cos(math.tau * k / n))
                           + ey * (rr * math.sin(math.tau * k / n))) for k in range(n)])
    return K.loft(name, rows, True)


def ering(cx, cy, z, w, d, n=12):
    """椭圆截面环；角度 0 = +Y 正前，与 arc_panel 完全同口径。"""
    return [(cx + w * 0.5 * math.sin(math.tau * k / n),
             cy + d * 0.5 * math.cos(math.tau * k / n), z) for k in range(n)]


def etube(name, stations, n=12):
    """stations = [(z, cx, cy, w, d)]；整根椭圆放样。"""
    return K.loft(name, [ering(cx, cy, z, w, d, n) for (z, cx, cy, w, d) in stations], True)


def flat_plate(name, pts_xz, thick, y_of, out=0.0):
    """在"正面近似平面"上的一小块凸起（x,z 多边形，沿 Y 挤出，y 随 z 变）。"""
    front = [(x, y_of(z) + out + thick, z) for (x, z) in pts_xz]
    back = [(x, y_of(z) + out, z) for (x, z) in pts_xz]
    n = len(pts_xz)
    verts = front + back
    faces = [(i, (i + 1) % n, n + (i + 1) % n, n + i) for i in range(n)]
    faces.append(tuple(range(n - 1, -1, -1)))
    faces.append(tuple(range(n, 2 * n)))
    return KU._obj(name, verts, faces)


def seg_pt(p0, p1, z):
    """沿 p0→p1 的骨轴取 z 高度处的 (x, y)。"""
    p0, p1 = Vector(p0), Vector(p1)
    t = (z - p0.z) / (p1.z - p0.z)
    t = max(0.0, min(1.0, t))
    p = p0 + (p1 - p0) * t
    return p.x, p.y


# ══ 躯干轮廓（椭圆，供 arc 完全贴合） ══════════════════════════════════════
# (z, 宽, 厚, cy)
CHEST = [(2.800, 1.140, 0.640, -0.006),
         (2.920, 1.240, 0.702, -0.014),
         (3.040, 1.300, 0.734, -0.018),
         (3.200, 1.286, 0.720, -0.016),
         (3.340, 1.220, 0.664, -0.012),
         (3.440, 1.130, 0.606, -0.008),
         (3.520, 0.968, 0.542, -0.006)]


def chest_wd(z):
    if z <= CHEST[0][0]:
        return CHEST[0][1], CHEST[0][2], CHEST[0][3]
    if z >= CHEST[-1][0]:
        return CHEST[-1][1], CHEST[-1][2], CHEST[-1][3]
    for i in range(len(CHEST) - 1):
        z0, w0, d0, c0 = CHEST[i]
        z1, w1, d1, c1 = CHEST[i + 1]
        if z0 <= z <= z1:
            t = (z - z0) / (z1 - z0)
            return (w0 + (w1 - w0) * t, d0 + (d1 - d0) * t, c0 + (c1 - c0) * t)
    return CHEST[-1][1], CHEST[-1][2], CHEST[-1][3]


def chest_front(z):
    w, d, cy = chest_wd(z)
    return cy + d * 0.5


# ══ 1. 腿 ═══════════════════════════════════════════════════════════════════
# (z, 宽, 厚) —— 铁内胆轮廓，甲片沿它偏移
LEG_FLESH = [(2.060, 0.484, 0.520), (1.880, 0.500, 0.537), (1.660, 0.479, 0.516),
             (1.420, 0.449, 0.486), (1.200, 0.425, 0.460), (1.180, 0.417, 0.450),
             (1.000, 0.407, 0.438), (0.800, 0.393, 0.423), (0.580, 0.374, 0.404),
             (0.360, 0.355, 0.383)]

ARMOR_OFF = 0.020


def leg_wd(z):
    if z >= LEG_FLESH[0][0]:
        return LEG_FLESH[0][1], LEG_FLESH[0][2]
    if z <= LEG_FLESH[-1][0]:
        return LEG_FLESH[-1][1], LEG_FLESH[-1][2]
    for i in range(len(LEG_FLESH) - 1):
        z0, w0, d0 = LEG_FLESH[i]
        z1, w1, d1 = LEG_FLESH[i + 1]
        if z1 <= z <= z0:
            t = (z - z0) / (z1 - z0)
            return w0 + (w1 - w0) * t, d0 + (d1 - d0) * t
    return LEG_FLESH[-1][1], LEG_FLESH[-1][2]


def leg_axis(side, z):
    hip, kne, ank = (HIP_R, KNE_R, ANK_R) if side == "R" else (HIP_L, KNE_L, ANK_L)
    if z >= kne.z:
        return seg_pt(hip, kne, z)
    return seg_pt(kne, ank, z)


def legs(u):
    for s, side in ((1, "R"), (-1, "L")):
        th, sh, ft, to = ("thigh_" + side, "shin_" + side, "foot_" + side, "toe_" + side)
        hip, kne, ank = (HIP_R, KNE_R, ANK_R) if s > 0 else (HIP_L, KNE_L, ANK_L)
        x = s * LEG_X

        # ── 铁内胆（大腿 / 小腿各一段，膝上重叠）──
        st_t = []
        for z in (2.06, 1.86, 1.52, 1.20):
            cx, cy = leg_axis(side, z)
            w, d = leg_wd(z)
            st_t.append((z, cx, cy, w, d))
        u.add(etube("lg_flesh_t_" + side, st_t, 6), th, "铁", "soft", "body", "flesh")

        st_s = []
        for z in (1.18, 0.98, 0.60, 0.36):
            cx, cy = leg_axis(side, z)
            w, d = leg_wd(z)
            st_s.append((z, cx, cy, w, d))
        u.add(etube("lg_flesh_s_" + side, st_s, 6), sh, "铁", "soft", "body", "flesh")

        # ── 大腿甲（前 216° 主片 + 后 128° 副片，侧面留铁色暗缝）──
        ax0, ay0 = leg_axis(side, 1.68)
        inside_t = (ax0, ay0, 1.68)
        front, back = [], []
        for z in (2.020, 1.880, 1.560, 1.320):
            w, d = leg_wd(z)
            ax, ay = leg_axis(side, z)
            front.append((z, -108, 108, w * 0.5 + ARMOR_OFF, d * 0.5 + ARMOR_OFF, ay))
            back.append((z, 116, 244, w * 0.5 + ARMOR_OFF - 0.006,
                         d * 0.5 + ARMOR_OFF - 0.006, ay))
        u.arc("lg_cuisse_" + side, front, 0.024, th, "金", "plate", "body", "thigh",
              nu=6, inside=inside_t, center=(ax0, 0.0))
        u.arc("lg_cuisse_b_" + side, back, 0.020, th, "金暗", "plate", "body", "thigh",
              nu=4, inside=inside_t, center=(ax0, 0.0))
        rib = []
        for z in (2.000, 1.700, 1.360):
            w, d = leg_wd(z)
            ax, ay = leg_axis(side, z)
            rib.append((z, -7, 7, w * 0.5 + ARMOR_OFF + 0.012,
                        d * 0.5 + ARMOR_OFF + 0.012, ay))
        u.arc("lg_cuisse_rib_" + side, rib, 0.014, th, "金暗", "plate", "body", "thigh",
              nu=2, inside=inside_t, center=(ax0, 0.0))

        # ── 膝（前包式护膝板：比大腿/胫甲都宽 4 cm，把关节缝盖在下面）──
        kz = kne.z
        kst = []
        for (z, ex, ey) in ((kz + 0.170, 0.008, 0.020), (kz + 0.080, 0.020, 0.046),
                            (kz - 0.020, 0.024, 0.052), (kz - 0.100, 0.014, 0.030)):
            w, d = leg_wd(z)
            ax, ay = leg_axis(side, z)
            kst.append((z, -110, 110, w * 0.5 + ARMOR_OFF + ex,
                        d * 0.5 + ARMOR_OFF + ey, ay))
        kx, ky = leg_axis(side, kz)
        u.arc("lg_poleyn_" + side, kst, 0.030, sh, "金", "plate", "body", "knee",
              nu=6, inside=(kx, ky, kz), center=(kx, 0.0))
        krim = []
        for (z, ex, ey) in ((kz + 0.186, 0.006, 0.016), (kz + 0.150, 0.010, 0.024)):
            w, d = leg_wd(z)
            ax, ay = leg_axis(side, z)
            krim.append((z, -108, 108, w * 0.5 + ARMOR_OFF + ex,
                         d * 0.5 + ARMOR_OFF + ey, ay))
        u.arc("lg_poleyn_rim_" + side, krim, 0.014, sh, "金暗", "hard", "body", "knee",
              nu=6, inside=(kx, ky, kz), center=(kx, 0.0))

        # ── 小腿甲（前 212° + 后 132°）──
        sx, sy = leg_axis(side, 0.74)
        inside_s = (sx, sy, 0.74)
        gf, gb = [], []
        for z in (1.060, 0.920, 0.640, 0.470):
            w, d = leg_wd(z)
            ax, ay = leg_axis(side, z)
            gf.append((z, -106, 106, w * 0.5 + ARMOR_OFF, d * 0.5 + ARMOR_OFF, ay))
            gb.append((z, 114, 246, w * 0.5 + ARMOR_OFF - 0.006,
                       d * 0.5 + ARMOR_OFF - 0.006, ay))
        u.arc("lg_greave_" + side, gf, 0.022, sh, "金", "plate", "body", "shin",
              nu=6, inside=inside_s, center=(sx, 0.0))
        u.arc("lg_greave_b_" + side, gb, 0.019, sh, "金暗", "plate", "body", "shin",
              nu=4, inside=inside_s, center=(sx, 0.0))
        rib2 = []
        for z in (1.030, 0.760, 0.500):
            w, d = leg_wd(z)
            ax, ay = leg_axis(side, z)
            rib2.append((z, -8, 8, w * 0.5 + ARMOR_OFF + 0.012,
                         d * 0.5 + ARMOR_OFF + 0.012, ay))
        u.arc("lg_greave_rib_" + side, rib2, 0.013, sh, "金暗", "plate", "body", "shin",
              nu=2, inside=inside_s, center=(sx, 0.0))

        # ── 踝套筒（铁色，填小腿/靴之间的缝）──
        u.add(limb_band("lg_ankle_" + side, (x, 0.030, 0.470), (x, 0.030, 0.330),
                        0.158, 0.166, -180, 180, 1, 8, 0.012, (0, 1, 0)),
              sh, "铁", "hard", "body", "joint")

        # ── 靴（大、厚、圆头；鞋底内缩，不做滑板）──
        u.add(K.loft("lg_boot_" + side,
                     [ering(x, 0.020, 0.450, 0.396, 0.400, 10),
                      ering(x, 0.046, 0.290, 0.449, 0.470, 10),
                      ering(x, 0.082, 0.085, 0.466, 0.560, 10),
                      ering(x, 0.090, 0.026, 0.429, 0.522, 10)]),
              ft, "金", "soft", "body", "boot")
        u.add(etube("lg_sole_" + side, [(0.000, x, 0.090, 0.409, 0.508),
                                        (0.040, x, 0.090, 0.431, 0.528)], 10),
              ft, "铁", "hard", "body", "boot")
        u.add(dome_patch("lg_toecap_" + side, (x, 0.176, 0.098), 0.168, 0.180, 0.120,
                         -80, 80, 24, 86, 7, 3, 0.016),
              to, "金暗", "plate", "body", "boot")
        u.add(limb_band("lg_cuff_" + side, (x, 0.022, 0.474), (x, 0.026, 0.418),
                        0.160, 0.164, -180, 180, 1, 8, 0.014, (0, 1, 0)),
              ft, "金暗", "hard", "body", "boot")


# ══ 2. 胯 / 腰 ══════════════════════════════════════════════════════════════
def pelvis(u):
    u.add(etube("bd_hip", [(1.860, 0, 0.000, 0.880, 0.600),
