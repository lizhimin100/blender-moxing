# ══ 3. 躯干 ═════════════════════════════════════════════════════════════════
def torso(u):
    # 铁色躯干内胆（连续，填所有段缝）
    u.add(etube("bd_core", [(2.060, 0, 0.000, 0.840, 0.560),
                            (2.300, 0, -0.002, 0.820, 0.542),
                            (2.560, 0, -0.008, 0.930, 0.596),
                            (2.820, 0, -0.014, 1.130, 0.662),
                            (3.080, 0, -0.018, 1.220, 0.700),
                            (3.460, 0, -0.010, 1.030, 0.570)], 8),
          "chest", "铁", "soft", "body", "core")

    # 腰：腹部三段横甲（金暗 → 金 → 金），段间 3.5 cm 铁缝
    bands = [((2.272, 2.408), (0.886, 0.566), (0.938, 0.594), "金暗"),
             ((2.444, 2.596), (0.950, 0.600), (1.020, 0.634), "金"),
             ((2.632, 2.788), (1.040, 0.644), (1.136, 0.686), "金")]
    for i, ((z0, z1), (w0, d0), (w1, d1), mat) in enumerate(bands):
        u.arc("bd_ab%d" % i,
              [(z0, -180, 180, w0 * 0.5, d0 * 0.5), (z1, -180, 180, w1 * 0.5, d1 * 0.5)],
              0.028, "spine", mat, "plate", "body", "abdomen", nu=6,
              inside=(0, 0, (z0 + z1) * 0.5))

    # 胸甲
    u.add(etube("bd_chest", [(z, 0, cy, w, d) for (z, w, d, cy) in CHEST], 12),
          "chest", "金", "soft", "body", "chest")
    # 胸甲下沿一道暗金唇边（把胸/腹的段缝收成"叠压"）
    br = []
    for z in (2.796, 2.836):
        w, d, cy = chest_wd(z)
        br.append((z, -180, 180, w * 0.5 + 0.014, d * 0.5 + 0.014, cy))
    u.arc("bd_chest_lip", br, 0.016, "chest", "金暗", "hard", "body", "chest",
          nu=10, inside=(0, 0, 2.82))

    # 上胸甲片（压出领口一条硬边）
    up = []
    for z in (3.040, 3.180, 3.300, 3.400):
        w, d, cy = chest_wd(z)
        up.append((z, -48, 48, w * 0.5 + 0.016, d * 0.5 + 0.016, cy))
    u.arc("bd_pec", up, 0.024, "chest", "金", "plate", "body", "chest", nu=9,
          inside=(0, 0, 3.24))
    # 胸口中脊
    u.arc("bd_sternum", [(2.800, -8, 8, 0.582, 0.330), (2.930, -8, 8, 0.632, 0.364),
                         (3.060, -7, 7, 0.662, 0.378), (3.170, -7, 7, 0.654, 0.372)],
          0.016, "chest", "金暗", "plate", "body", "chest", nu=2, inside=(0, 0, 2.98))
    # 背脊
    u.arc("bd_spine_ridge", [(2.860, 173, 187, 0.580, 0.336), (3.020, 173, 187, 0.640, 0.376),
                             (3.180, 173, 187, 0.646, 0.372)],
          0.018, "chest", "金暗", "plate", "body", "chest", nu=2, inside=(0, 0, 3.02))
    # 护喉（把"脖子插在棍上"堵掉）
    u.add(etube("bd_gorget", [(3.478, 0, -0.006, 1.030, 0.576),
                              (3.545, 0, -0.006, 0.880, 0.508),
                              (3.596, 0, -0.006, 0.680, 0.424),
                              (3.630, 0, -0.006, 0.526, 0.370)], 10),
          "chest", "金暗", "plate", "body", "gorget")
    u.add(etube("bd_gorget_rim", [(3.624, 0, -0.006, 0.532, 0.374),
                                  (3.646, 0, -0.006, 0.500, 0.360)], 12),
          "chest", "team_trim", "hard", "body", "gorget")


# ══ 4. 臂 / 拳 ══════════════════════════════════════════════════════════════
def arms(u):
    for s, side in ((1, "R"), (-1, "L")):
        sh = SH_R if s > 0 else SH_L
        el = ELB_R if s > 0 else ELB_L
        wr = WRI_R if s > 0 else WRI_L
        ua, fa = "upperarm_" + side, "forearm_" + side
        out = (s * 0.92, -0.39, 0.0)

        # 肩窝（铁色球窝，藏在护肩下面）
        u.capsule("jt_shoulder_" + side, sh + Vector((0, 0, 0.04)),
                  sh + Vector((s * 0.03, -0.01, -0.10)), 0.190, 0.180,
                  ua, "铁", "soft", "body", "joint", nc=1)
        # 上臂内胆（暗金，肩根加粗：把护肩下面的空腔填掉）
        u.capsule("ar_upper_" + side, sh + Vector((0, 0, 0.01)),
                  el + (sh - el).normalized() * 0.03, 0.242, 0.180,
                  ua, "金暗", "soft", "body", "upper", nc=1)
        # 上臂甲（外 264°，从肩根一直包到肘上）
        u.add(limb_band("ar_rere_" + side, sh + (el - sh).normalized() * 0.005,
                        el + (sh - el).normalized() * 0.055,
                        0.252, 0.214, -132, 132, 2, 5, 0.028, out),
              ua, "金", "plate", "body", "upper")
        u.add(limb_band("ar_rere_rib_" + side, sh + (el - sh).normalized() * 0.02,
                        el + (sh - el).normalized() * 0.075,
                        0.259, 0.221, -9, 9, 2, 2, 0.016, out),
              ua, "金暗", "plate", "body", "upper")

        # 肘
        u.capsule("jt_elbow_" + side, el + (sh - el).normalized() * 0.04,
                  el + (wr - el).normalized() * 0.04, 0.142, 0.142,
                  fa, "铁", "soft", "body", "joint", nc=1)
        thc = -40 if s > 0 else 220
        u.add(dome_patch("ar_couter_" + side, (el.x, el.y - 0.010, el.z),
                         0.188, 0.184, 0.168, thc - 60, thc + 60, 26, 104, 7, 2, 0.024),
              fa, "金", "plate", "body", "elbow")

        # 前臂内胆
        u.capsule("ar_fore_" + side, el + (wr - el).normalized() * 0.025,
                  wr + (el - wr).normalized() * 0.015, 0.172, 0.156,
                  fa, "金暗", "soft", "body", "fore", nc=1)
        # 前臂甲（外 260°，向腕部外张）
        u.add(limb_band("ar_vamb_" + side, el + (wr - el).normalized() * 0.025,
                        wr + (el - wr).normalized() * 0.015,
                        0.206, 0.216, -130, 130, 2, 5, 0.026, out),
              fa, "金", "plate", "body", "fore")
        u.add(limb_band("ar_vamb_rib_" + side, el + (wr - el).normalized() * 0.05,
                        wr + (el - wr).normalized() * 0.03,
                        0.205, 0.222, -8, 8, 2, 2, 0.015, out),
              fa, "金暗", "plate", "body", "fore")
        # 腕箍
        u.add(limb_band("ar_cuff_" + side, wr + (el - wr).normalized() * 0.035,
                        wr + (el - wr).normalized() * 0.005,
                        0.222, 0.226, -180, 180, 1, 8, 0.018, (0, 1, 0)),
              fa, "金暗", "hard", "body", "cuff")

    fist(u, "R", FIST_R)
    fist(u, "L", FIST_L)


def fist(u, side, c):
    bone = "hand_" + side
    s = 1 if side == "R" else -1
    hw, hd, hh = FIST_W * 0.5, FIST_D * 0.5, FIST_H * 0.5
    # 拳体：上宽下略收，正面 +Y 是平的
    rows = []
    for (dz, k) in ((hh, 0.72), (hh * 0.80, 0.94), (hh * 0.30, 1.00),
                    (-hh * 0.30, 0.99), (-hh * 0.76, 0.90), (-hh, 0.66)):
        w = FIST_W * k
        d = FIST_D * min(1.0, k + 0.05)
        r = 0.075 + 0.070 * k
        rows.append([(c.x + p[0], c.y + p[1], c.z + dz)
                     for p in K.rrect(w, d, r, 1)])
    u.add(K.loft("ar_fist_" + side, rows), bone, "金", "soft", "body", "hand")

    # 四个指节：只在上半段，横向排列（读成"握拳"而不是"木桶"）
    for i in range(4):
        kx = c.x + (i - 1.5) * 0.140
        u.add(K.loft("ar_knuckle%d_%s" % (i, side),
                     [ering(kx, c.y + hd - 0.020, c.z + 0.222, 0.118, 0.096, 6),
                      ering(kx, c.y + hd + 0.002, c.z + 0.180, 0.136, 0.114, 6),
                      ering(kx, c.y + hd + 0.002, c.z + 0.060, 0.136, 0.114, 6),
                      ering(kx, c.y + hd - 0.020, c.z + 0.018, 0.118, 0.096, 6)]),
              bone, "金暗", "soft", "body", "hand")
    # 拳面横沟（铁色）
    u.box("ar_fist_gap_" + side, (c.x, c.y + hd - 0.004, c.z - 0.030),
          (FIST_W * 0.80, 0.044, 0.026), bone, "铁", style="hard",
          module="body", tag="hand")
    # 拇指：内侧，从腕侧包到拳面
    u.capsule("ar_thumb_" + side,
              (c.x - s * (hw - 0.055), c.y - 0.105, c.z + 0.215),
              (c.x - s * (hw + 0.030), c.y + 0.170, c.z - 0.075),
              0.100, 0.088, bone, "金", "soft", "body", "hand", nc=1)
    # 腕套（铁色，填拳与前臂的缝）
    u.add(limb_band("ar_wrist_" + side, (c.x, c.y - 0.020, c.z + 0.395),
                    (c.x, c.y - 0.010, c.z + 0.300),
                    0.150, 0.160, -180, 180, 1, 8, 0.014, (0, 1, 0)),
          bone, "铁", "hard", "body", "joint")


# ══ 5. 护肩 ═════════════════════════════════════════════════════════════════
def pauldrons(u):
    for s, side in ((1, "R"), (-1, "L")):
        c = (PAUL_C.x * s, PAUL_C.y, PAUL_C.z)
        a0, a1 = (-152, 152) if s > 0 else (28, 332)
        # 主片：从肩顶一直垂到臂根（phi 到 116°）
        u.add(dome_patch("pd_main_" + side, c, 0.358, 0.352, 0.300,
                         a0, a1, 2, 124, 10, 3, 0.034, tilt=-s * 16),
              "shoulder_" + side, "金", "plate", "pauldron", "pauldron")
        # 主片下沿亮金唇边（同色提亮，不做暗环）
        u.add(dome_patch("pd_rim_" + side, c, 0.366, 0.360, 0.306,
                         a0 + 2, a1 - 2, 116, 124, 10, 1, 0.024, tilt=-s * 16),
              "shoulder_" + side, "金", "hard", "pauldron", "rim")
        # 副片：第二层，压在臂根（半径略小、压暗，藏进主片下面）
        u.add(dome_patch("pd_lame_" + side, c, 0.336, 0.332, 0.286,
                         a0 + 14, a1 - 14, 104, 134, 7, 2, 0.030, tilt=-s * 16),
              "shoulder_" + side, "金暗", "plate", "pauldron", "lame")
        # 顶级钉线
        u.add(dome_patch("pd_trim_" + side, c, 0.362, 0.356, 0.304,
                         a0 + 40, a1 - 40, 20, 27, 7, 1, 0.016, tilt=-s * 16),
              "shoulder_" + side, "team_trim", "hard", "pauldron", "trim")
        # 内垫：在护肩壳里面再套一层，消掉俯视/侧视能看到的黑洞
        u.add(dome_patch("pd_pad_" + side, c, 0.302, 0.298, 0.258,
                         a0 + 8, a1 - 8, 20, 126, 6, 3, 0.026, tilt=-s * 16),
              "shoulder_" + side, "金暗", "plate", "pauldron", "pad")


# ══ 6. 头 ═══════════════════════════════════════════════════════════════════
HELM = [(3.652, 0.440, 0.470), (3.702, 0.520, 0.545), (3.782, 0.556, 0.580),
        (3.884, 0.560, 0.584), (3.984, 0.542, 0.566), (4.088, 0.494, 0.520),
        (4.194, 0.392, 0.416), (4.288, 0.238, 0.256)]
HELM_Y = 0.012


def helm_wd(z):
    if z <= HELM[0][0]:
        return HELM[0][1], HELM[0][2]
    if z >= HELM[-1][0]:
        return HELM[-1][1], HELM[-1][2]
    for i in range(len(HELM) - 1):
        z0, w0, d0 = HELM[i]
        z1, w1, d1 = HELM[i + 1]
        if z0 <= z <= z1:
            t = (z - z0) / (z1 - z0)
            return w0 + (w1 - w0) * t, d0 + (d1 - d0) * t
    return HELM[-1][1], HELM[-1][2]


def helm_patch(name, zs, a0, a1, nu, off, thick):
    grid = []
    for z in zs:
        w, d = helm_wd(z)
        row = []
        for i in range(nu + 1):
            a = math.radians(a0 + (a1 - a0) * i / nu)
            row.append(((w * 0.5 + off) * math.sin(a),
                        HELM_Y + (d * 0.5 + off) * math.cos(a), z))
        grid.append(row)
    return K.grid_shell(name, grid, thick, inside=(0, HELM_Y, sum(zs) / len(zs)))


def head(u):
    # 颈（粗，藏在护喉里）
    u.add(etube("jt_neck", [(3.420, 0, 0.008, 0.440, 0.440),
                            (3.520, 0, 0.008, 0.408, 0.412),
                            (3.640, 0, 0.008, 0.376, 0.386),
                            (3.700, 0, 0.008, 0.360, 0.370)], 10),
          "neck", "铁", "soft", "head", "neck")

    # 盔体：光滑圆顶（14 边椭圆 + CC）
    u.add(etube("hd_helm", [(z, 0, HELM_Y, w, d) for (z, w, d) in HELM], 11),
          "head", "金", "soft", "head", "helm")

    # 面甲（眼缝以下）
    u.add(helm_patch("hd_mask", [3.690, 3.820, 3.944], -58, 58, 7, 0.012, 0.018),
          "head", "金暗", "plate", "head", "mask")
    # 颌线金带
    u.add(helm_patch("hd_jaw", [3.654, 3.712], -106, 106, 10, 0.010, 0.014),
          "head", "金", "plate", "head", "jaw")
    # 眼缝：暗槽 + 发光条
    u.add(helm_patch("hd_slit", [3.926, 3.972], -52, 52, 8, 0.003, 0.014),
          "head", "铁", "plate", "head", "slit")
    for s2 in (1, -1):
        u.add(helm_patch("hd_eye_%d" % s2, [3.934, 3.966],
                         s2 * 10, s2 * 40, 4, 0.010, 0.010),
              "head", "辉", "hard", "head", "eye")
    # 眉脊
    u.add(helm_patch("hd_brow", [3.974, 4.014], -56, 56, 8, 0.012, 0.016),
          "head", "金", "plate", "head", "brow")
    # 盔顶低脊（沿 Y）
    u.add(K.loft("hd_ridge",
                 [[(-0.030, 0.180, 4.150), (0.030, 0.180, 4.150),
                   (0.030, 0.180, 4.196), (0.0, 0.180, 4.212),
                   (-0.030, 0.180, 4.196)],
                  [(-0.032, 0.030, 4.284), (0.032, 0.030, 4.284),
                   (0.032, 0.030, 4.330), (0.0, 0.030, 4.348),
                   (-0.032, 0.030, 4.330)],
                  [(-0.028, -0.120, 4.226), (0.028, -0.120, 4.226),
                   (0.028, -0.120, 4.268), (0.0, -0.120, 4.284),
                   (-0.028, -0.120, 4.268)],
                  [(-0.020, -0.212, 4.100), (0.020, -0.212, 4.100),
                   (0.020, -0.212, 4.134), (0.0, -0.212, 4.146),
                   (-0.020, -0.212, 4.134)]]),
          "head", "金", "plate", "head", "ridge")
    # 后颈护甲
    u.add(dome_patch("hd_nape", (0, 0.004, 3.836), 0.292, 0.302, 0.242,
                     106, 254, 48, 108, 6, 2, 0.020),
          "head", "金暗", "plate", "head", "nape")
    # 盔底沿
    u.add(helm_patch("hd_helm_rim", [3.654, 3.676], -180, 180, 12, 0.010, 0.012),
          "head", "team_trim", "hard", "head", "rim")


# ══ 7. 发光纹路 ═════════════════════════════════════════════════════════════
def runes(u):
    cc = CORE_C
    # 胸口核心：外圈金 → team 环 → 金 → 发光芯
    u.add(disc("mg_core_bezel", cc, (0, 1, 0), 0.210, 0.080, 12),
          "core", "金", "plate", "runes", "core")
    u.add(disc("mg_core_ring", cc + Vector((0, 0.030, 0)), (0, 1, 0), 0.156, 0.056, 12),
          "core", "team", "plate", "runes", "core")
    u.add(disc("mg_core_inner", cc + Vector((0, 0.050, 0)), (0, 1, 0), 0.114, 0.046, 12),
          "core", "金", "hard", "runes", "core")
    u.add(disc("mg_core_glow", cc + Vector((0, 0.066, 0)), (0, 1, 0), 0.084, 0.042, 12),
          "core", "辉", "hard", "runes", "core")

    # 胸口四道斜向光条（绕核心呈放射状）
    for i, ang in enumerate((40, 140, 220, 320)):
        a = math.radians(ang)
        p0 = (0.238 * math.sin(a), cc.z + 0.238 * math.cos(a))
        p1 = (0.352 * math.sin(a), cc.z + 0.352 * math.cos(a))
        p0 = (p0[0], max(2.86, min(3.30, p0[1])))
        p1 = (p1[0], max(2.86, min(3.30, p1[1])))
        dx, dz = p1[0] - p0[0], p1[1] - p0[1]
        L = math.hypot(dx, dz)
        nx, nz = -dz / L, dx / L
        w0, w1 = 0.019, 0.013
        poly = [(p0[0] + nx * w0, p0[1] + nz * w0), (p1[0] + nx * w1, p1[1] + nz * w1),
                (p1[0] - nx * w1, p1[1] - nz * w1), (p0[0] - nx * w0, p0[1] - nz * w0)]
        u.add(flat_plate("mg_rune_chest%d" % i, poly, 0.014, chest_front),
              "rune_chest", "辉", "sharp", "runes", "rune")

    # 护肩光条：贴主片外表面两条（phi 34..96）
    for s, side in ((1, "R"), (-1, "L")):
        c = (PAUL_C.x * s, PAUL_C.y, PAUL_C.z)
        for k, th in enumerate((-30, 28)):
            u.add(dome_patch("mg_rune_sh_%s%d" % (side, k), c,
                             0.368, 0.362, 0.310, th - 6, th + 6, 34, 96, 2, 4, 0.012,
                             tilt=-s * 16),
                  "rune_" + side, "辉", "hard", "runes", "rune")

    # 前臂光条（沿护腕外侧两条）
    for s, side in ((1, "R"), (-1, "L")):
        el = ELB_R if s > 0 else ELB_L
        wr = WRI_R if s > 0 else WRI_L
        out = (s * 0.92, -0.39, 0.0)
        for k, a in enumerate((-24, 22)):
            u.add(limb_band("mg_rune_fa_%s%d" % (side, k),
                            el + (wr - el).normalized() * 0.10,
                            wr + (el - wr).normalized() * 0.05,
                            0.182, 0.198, a - 6, a + 6, 3, 2, 0.010, out),
                  "forearm_" + side, "辉", "hard", "runes", "rune")

    # 腿光条（大腿外侧 / 小腿外侧各一条）
    for s, side in ((1, "R"), (-1, "L")):
        ang = s * 90.0
        st = []
        for z in (1.940, 1.800, 1.640, 1.460):
            w, d = leg_wd(z)
            ax, ay = leg_axis(side, z)
            st.append((z, ang - 7, ang + 7, w * 0.5 + ARMOR_OFF + 0.013,
                       d * 0.5 + ARMOR_OFF + 0.013, ay))
        ax, ay = leg_axis(side, 1.70)
        u.arc("mg_rune_th_" + side, st, 0.010, "thigh_" + side, "辉", "hard",
              "runes", "rune", nu=2, inside=(ax, ay, 1.70), center=(ax, 0.0))
        st2 = []
        for z in (1.000, 0.870, 0.720, 0.580):
            w, d = leg_wd(z)
            ax, ay = leg_axis(side, z)
            st2.append((z, ang - 6, ang + 6, w * 0.5 + ARMOR_OFF + 0.013,
                        d * 0.5 + ARMOR_OFF + 0.013, ay))
        ax, ay = leg_axis(side, 0.80)
        u.arc("mg_rune_sh_" + side, st2, 0.010, "shin_" + side, "辉", "hard",
              "runes", "rune", nu=2, inside=(ax, ay, 0.80), center=(ax, 0.0))


# ══ 组装 ════════════════════════════════════════════════════════════════════
def build(low=False, modules=None):
    want = set(MODULES if modules is None else modules)
    u = K.Unit2(PREFIX, MATS, low=low)
    if "body" in want:
        legs(u)
        pelvis(u)
        torso(u)
        arms(u)
    if "head" in want:
        head(u)
    if "pauldron" in want:
        pauldrons(u)
    if "runes" in want:
        runes(u)
    return u


def build_rig(name="RIG_魔金傀儡"):
    return K.build_rig(BONES, name)


def report():
    return "\n".join([
        "[joints] hip=%.3f knee=(%.3f,%.3f) ankle=%.3f top=%.3f"
        % (Z_HIP, KNE_R.y, KNE_R.z, Z_ANKLE, Z_TOP),
        "[armR] elbow=(%.3f,%.3f,%.3f) wrist=(%.3f,%.3f,%.3f) reach=%.3f/%.3f"
        % (ELB_R.x, ELB_R.y, ELB_R.z, WRI_R.x, WRI_R.y, WRI_R.z,
           (WRI_R - SH_R).length, L_UPPER + L_FORE),
        "[armL] elbow=(%.3f,%.3f,%.3f) wrist=(%.3f,%.3f,%.3f) reach=%.3f/%.3f"
        % (ELB_L.x, ELB_L.y, ELB_L.z, WRI_L.x, WRI_L.y, WRI_L.z,
           (WRI_L - SH_L).length, L_UPPER + L_FORE),
        "[fist] c=(%.3f,%.3f,%.3f) size=%.2fx%.2fx%.2f span_x=%.3f"
        % (FIST_R.x, FIST_R.y, FIST_R.z, FIST_W, FIST_D, FIST_H,
           (FIST_R.x + FIST_W * 0.5) * 2),
        "[bones] %d" % len(BONES),
    ])
