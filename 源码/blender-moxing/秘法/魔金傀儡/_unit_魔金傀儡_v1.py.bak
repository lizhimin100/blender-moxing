    u.arc("bd_cod", [(1.880, -32, 32, 0.440, 0.330), (1.960, -32, 32, 0.482, 0.348),
                     (2.050, -30, 30, 0.504, 0.344), (2.120, -30, 30, 0.482, 0.320)],
          0.022, "hips", "金暗", "plate", "body", "pelvis", nu=6, inside=(0, 0, 2.0))
    # 腰带（铁色缝 + 金暗带）
    u.add(etube("bd_belt", [(2.168, 0, -0.004, 0.900, 0.580),
                            (2.200, 0, -0.004, 0.884, 0.566),
                            (2.240, 0, -0.004, 0.878, 0.562),
                            (2.272, 0, -0.004, 0.890, 0.570)], 12),
