                                 (2.242, 0, -0.004, 0.886, 0.566)], 12),
          "hips", "金暗", "plate", "body", "belt")
    for s in (1, -1):
        u.arc("bd_team_%d" % s,
              [(2.206, s * 62, s * 118, 0.452, 0.288),
